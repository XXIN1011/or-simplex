      "css": ".ds-tag{display:inline-block;font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"HarmonyOS Sans SC\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:12px;font-weight:650;line-height:1.65;color:var(--accent-text,#1d4ed8);background:var(--accent-soft,#eef4ff);padding:3px 10px;border-radius:999px}.ds-tag.ds-done{color:var(--ok,#116b33);background:var(--ok-soft,#eefbf2)}@media(prefers-reduced-motion:reduce){.ds-tag,.ds-done{transition:none!important;animation:none!important}}"
