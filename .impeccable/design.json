  "components": [
    {
      "name": "主求解按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "48px 起的填满主操作；深色主题沿用成对的按钮语义色。",
      "html": "<button class=\"ds-primary\">求　解</button>",
      "css": ".ds-primary{font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"HarmonyOS Sans SC\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:13.5px;font-weight:600;line-height:1.65;min-height:44px;padding:8px 13px;border:1px solid var(--line2,#c4cdd9);border-radius:var(--r,10px);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:background var(--duration-fast,140ms),border-color var(--duration-fast,140ms),color var(--duration-fast,140ms);width:100%;min-height:48px;padding:12px 16px;font-size:16px;font-weight:650;letter-spacing:.06em;background:var(--button-bg,#2563eb);color:var(--button-fg,#fff);border-color:transparent}.ds-primary:focus-visible{outline:2px solid var(--accent,#2563eb);outline-offset:2px;}.ds-primary:active{filter:brightness(.94);transform:translateY(1px)}.ds-primary:disabled{opacity:.45;transform:none;filter:none;cursor:default}@media(hover:hover){.ds-primary:not(:disabled):hover{background:var(--accent-text,#1d4ed8)}:host-context(html[data-theme=\"dark\"]) .ds-primary:not(:disabled):hover{background:var(--accent-hi,#a3bdff)}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none!important;animation:none!important}}"
    },
    {
      "name": "次操作按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "增减模型、历史和学习流程的次操作，保留至少 44px 高度。",
      "html": "<button class=\"ds-secondary\">＋ 变量</button>",
      "css": ".ds-secondary{font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"HarmonyOS Sans SC\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:13.5px;font-weight:600;line-height:1.65;min-height:44px;padding:8px 13px;border:1px solid var(--line2,#c4cdd9);border-radius:var(--r,10px);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:background var(--duration-fast,140ms),border-color var(--duration-fast,140ms),color var(--duration-fast,140ms);background:var(--input,#fff);color:var(--fg,#182230)}.ds-secondary:focus-visible{outline:2px solid var(--accent,#2563eb);outline-offset:2px;}.ds-secondary:active{background:var(--soft,#f1f4f9);transform:translateY(1px)}.ds-secondary:disabled{opacity:.45;transform:none;cursor:default}@media(hover:hover){.ds-secondary:not(:disabled):hover{background:var(--soft,#f1f4f9);border-color:var(--control-line,#8491a3)}}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none!important;animation:none!important}}"
    },
    {
      "name": "矩阵数字输入",
      "kind": "input",
      "refersTo": "numeric-input",
      "description": "58×44px 的数字框，以占位 0 和清楚的焦点表示可编辑状态。",
      "html": "<input class=\"ds-num\" aria-label=\"目标系数\" inputmode=\"decimal\" placeholder=\"0\">",
      "css": ".ds-num{width:58px;height:44px;padding:0 2px;text-align:center;border:1px solid var(--control-line,#8491a3);border-radius:var(--r-sm,8px);font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"HarmonyOS Sans SC\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:16px;font-variant-numeric:tabular-nums;color:var(--fg,#182230);background:var(--input,#fff);transition:border-color .15s,box-shadow .15s,background .15s}.ds-num::placeholder{color:var(--fg3,#657287);opacity:1}.ds-num:focus{border-color:var(--accent,#2563eb);box-shadow:var(--focus,0 0 0 3px rgba(37,99,235,.20));outline:none}.ds-num:focus-visible{outline:2px solid var(--accent,#2563eb);outline-offset:2px;}.ds-num[aria-invalid=\"true\"]{border-color:var(--err,#c02626);box-shadow:0 0 0 1px var(--err,#c02626)}@media(prefers-reduced-motion:reduce){.ds-num{transition:none!important;animation:none!important}}"
    },
    {
      "name": "实色输入面板",
      "kind": "card",
