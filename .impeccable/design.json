      "html": "<a class=\"ds-row\" href=\"#/simplex\"><span><span class=\"ds-row-title\">单纯形法<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 5l7 7-7 7\"/></svg></span><span class=\"ds-row-description\">输入线性规划，查看最优解、单纯形表和灵敏度区间。</span></span></a>",
      "css": ".ds-row{display:flex;align-items:center;gap:16px;font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"HarmonyOS Sans SC\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;text-decoration:none;background:var(--card,#fff);border-bottom:1px solid var(--line,#dce2eb);padding:20px 16px;transition:background var(--duration-fast,140ms),border-color var(--duration-fast,140ms),color var(--duration-fast,140ms);}.ds-row>span{display:block;flex:1;min-width:0}.ds-row-title{display:flex;align-items:center;justify-content:space-between;gap:12px;color:var(--fg,#182230);font-size:18px;font-weight:650;line-height:1.4}.ds-row-title svg{width:16px;height:16px;color:var(--fg3,#657287);flex:none}.ds-row-description{display:block;max-width:65ch;margin-top:7px;font-size:13px;line-height:1.8;color:var(--fg2,#536174)}.ds-row:focus-visible{outline:2px solid var(--accent,#2563eb);outline-offset:2px;}.ds-row:active{background:var(--accent-soft,#eef4ff)}@media(hover:hover){.ds-row:hover{background:var(--soft,#f1f4f9)}.ds-row:hover svg{color:var(--accent-text,#1d4ed8)}}@media(prefers-reduced-motion:reduce){.ds-row,.ds-row-title,.ds-row-description{transition:none!important;animation:none!important}}"
    },
