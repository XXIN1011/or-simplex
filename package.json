{
  "name": "or-simplex",
  "version": "2.0.0",
  "description": "运筹学计算器：线性规划、灵敏度分析、整数规划、指派问题与运输问题（最小元素法 + MODI）的完整计算过程",
  "keywords": ["operations-research", "linear-programming", "simplex", "duality", "sensitivity-analysis", "integer-programming", "运筹学", "单纯形法"],
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "main": "src/index.js",
  "bin": {
    "or-simplex": "src/cli.js"
  },
  "files": [
    "src/",
    "index.html",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node src/build.js",
    "test": "node test/run-all.js",
    "test:unit": "node test/run-all.js --unit",
    "test:algorithm": "node test/run-all.js --algorithm",
    "test:ui": "node test/ui/verify-ui.js",
    "check": "node tools/check-registry.js && node tools/check-no-dp.js",
    "check:registry": "node tools/check-registry.js",
    "snapshot": "node test/algorithm/deep-snapshot.js",
    "snapshot:dom": "node tools/dom-snapshot.js index.html preview/dom-snapshot.txt",
    "audit": "node test/ui/audit.js --quiet",
    "verify": "node src/build.js && npm run check && node test/run-all.js && node test/ui/verify-ui.js --quiet",
    "cli": "node src/cli.js"
  }
}
